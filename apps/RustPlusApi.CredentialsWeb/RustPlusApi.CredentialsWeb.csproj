<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <!-- The app is net10.0-only and deliberately outside the netstandard2.0 parity story
             that governs src/. See docs/superpowers/specs/2026-09-03-credential-acquisition-website-design.md -->
        <UserSecretsId>rustplusapi-credentialsweb</UserSecretsId>
        <!-- tsconfig.json exists only so ESLint can type-check wwwroot/app.js (see eslint.config.mjs); it
             must never make Visual Studio's TypeScript build step part of this project. -->
        <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\RustPlusApi.Fcm.Registration\RustPlusApi.Fcm.Registration.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="RustPlusApi.CredentialsWeb.UnitTests" />
    </ItemGroup>

    <ItemGroup>
        <!-- The lint toolchain's files, not app content: the Web SDK globs every *.json beside the project
             as Content and would otherwise publish them (and ship them in the Docker image). -->
        <Content Remove="package.json;package-lock.json;tsconfig.json" />
        <None Include="package.json;package-lock.json;tsconfig.json" />
    </ItemGroup>

</Project>
