{
  // Not a build: nothing is compiled or emitted. typescript-eslint needs a TypeScript program to
  // run its type-aware rules (no-floating-promises has to know which calls return a Promise), and
  // this is the smallest program that covers the browser script.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": []
  },
  "include": ["wwwroot/**/*.js"]
}
