<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0; net10.0</TargetFrameworks>
        <PackageId>RustPlusApi</PackageId>
        <IsPackable>true</IsPackable>
        <Authors>HandyS11</Authors>
        <Owners>HandyS11</Owners>
        <Product>A Rust+ API</Product>
        <Description>A library for interacting with the Rust+ API.</Description>
        <PackageTags>rust rustplus rustplusapi</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <LicenseUrl>https://github.com/HandyS11/RustPlusApi/blob/main/LICENSE</LicenseUrl>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <RepositoryUrl>https://github.com/HandyS11/RustPlusApi</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="protobuf-net" />
        <PackageReference Include="protobuf-net.BuildTools" PrivateAssets="all" />
    </ItemGroup>

    <!-- IAsyncDisposable / ValueTask + Channels are in-box on net10.0; netstandard2.0 needs the packages. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
        <PackageReference Include="System.Threading.Channels" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="RustPlusApi.UnitTests" />
        <InternalsVisibleTo Include="RustPlusApi.IntegrationTests" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="Protobuf/RustPlusContracts.proto" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="../../icon.png" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
