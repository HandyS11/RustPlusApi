<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
        <PackageId>RustPlusApi</PackageId>
        <Version>1.4.0</Version>
        <Authors>HandyS11</Authors>
        <Owners>HandyS11</Owners>
        <Product>A Rust+ API</Product>
        <Description>A library for interacting with the Rust+ API.</Description>
        <PackageTags>rust rustplus rustplusapi</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <LicenseUrl>https://github.com/HandyS11/RustPlusApi/blob/main/LICENSE</LicenseUrl>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <RepositoryUrl>https://github.com/HandyS11/RustPlusApi</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="protobuf-net" />
        <PackageReference Include="protobuf-net.BuildTools" PrivateAssets="all" />
        <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" />
    </ItemGroup>

    <!-- RustPlusContracts is generated from the .proto at build time (v2 §3). -->
    <ItemGroup>
        <AdditionalFiles Include="Protobuf/RustPlusContracts.proto" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
