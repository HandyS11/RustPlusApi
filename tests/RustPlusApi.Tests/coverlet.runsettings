<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>opencover,cobertura</Format>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <Exclude>[RustPlusApi.MockServer]*</Exclude>
          <!-- Exclude mechanically-generated protobuf DTO files whose wire behavior is locked by
               round-trip tests (ProtobufRoundTripTests, McsRoundTripTests, RegistrationTests).
               RustPlusContracts is generated by protobuf-net.BuildTools into obj/;
               Mcs.cs and CheckinContracts.cs are code-first proto contracts whose
               ShouldSerialize*/Reset* members are not worth bespoke tests. -->
          <ExcludeByFile>**/obj/**,**/ProtoBuf/Mcs.cs,**/Protobuf/CheckinContracts.cs</ExcludeByFile>
          <SkipAutoProps>true</SkipAutoProps>
          <UseSourceLink>true</UseSourceLink>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
